rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {
        // Base cerrada de la Revision 1. El login y los roles aun no se integran.
        // Bloquea todas las colecciones y subcolecciones desde el SDK de cliente.
        // No habilita el guardado real del formulario ni la carga de semillas.
        // Antes de habilitar operaciones, implementar y probar la matriz de permisos
        // documentada en docs/estados_prioridades.md y docs/seguridad-revision-1.md.
        match /{document=**} {
            allow read, write: if false;
        }
    }
}
